# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials. These are read by starter_kit/llm_client.py
# via environment variables only (LOOMQ_LLM_* must never be hardcoded).

LOOMQ_LLM_BASE_URL=https://api.deepseek.com
LOOMQ_LLM_API_KEY=
LOOMQ_LLM_MODEL=deepseek-v4-flash

# Optional, defaults shown:
# LOOMQ_LLM_TIMEOUT_SECONDS=120
# LOOMQ_LLM_MAX_OUTPUT_TOKENS=4096

# Only needed for starter_kit/runner.py::run_originq_real_chip (real Wukong
# 72-qubit hardware, gathering L1 真机接入证据) -- not needed for the
# graded run() path, which uses the free local CPU simulator by default.
ORIGINQ_API_TOKEN=

# Only needed for starter_kit/runner.py::run_spinq_real_chip (real SpinQ
# Cloud QPU, gathering L1 真机接入证据) -- not needed for the graded run()
# path, which uses the free local BasicSimulator by default.
# SPINQ_KEYFILE_PATH points to an RSA private key registered with SpinQ
# Cloud (signs SPINQ_USERNAME to authenticate) -- keep the key file itself
# OUTSIDE the repo, this only stores its path.
SPINQ_USERNAME=
SPINQ_KEYFILE_PATH=
